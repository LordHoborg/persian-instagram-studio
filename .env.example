# OpenAI Configuration
OPENAI_API_KEY=
USE_MOCK_AI=true

# Model Configuration (optional - defaults are set in code)
OPENAI_MODEL_CHEAP=gpt-5.6-luna
OPENAI_MODEL_STANDARD=gpt-5.6-terra
OPENAI_MODEL_PREMIUM=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional browser binary used for carousel PNG export.
# Leave empty to use Playwright's bundled Chromium.
CHROME_EXECUTABLE_PATH=

# Database
DATABASE_URL=./data/studio.db
